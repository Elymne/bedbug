-- Erreurs inattendues enregistrées par les use cases et services.
import '../../drift.converters.dart';

CREATE TABLE error_logs (
  id TEXT NOT NULL PRIMARY KEY,
  created_at INTEGER NOT NULL MAPPED BY `const MillisDateTimeConverter()`,
  updated_at INTEGER NOT NULL MAPPED BY `const MillisDateTimeConverter()`,
  source TEXT NOT NULL,
  error_type TEXT NOT NULL,
  message TEXT NOT NULL,
  stack_trace TEXT NOT NULL
) AS ErrorLogRow;

CREATE INDEX error_logs_created_at ON error_logs (created_at);
